# Blue Park configuration. Copy to .env and fill in. Never commit real secrets.

# demo = fixtures only (nothing sent, charged or published). live = real adapters where configured.
BLUEPARK_MODE=demo
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DATA_DIR=data

# Required in live mode
SESSION_SECRET=            # 32+ random characters
ADMIN_PASSWORD=            # 12+ characters; protects /admin
SECURE_COOKIES=            # defaults to true in live mode (requires HTTPS)
SUPPORT_EMAIL=

# Operations (can also be changed in /admin/settings)
REQUIRE_PREVIEW_REVIEW=false
REQUIRE_LAUNCH_REVIEW=true
PREVIEW_TARGET_BUSINESS_DAYS=1
UPDATE_TURNAROUND_BUSINESS_DAYS=2

# Business lookup by name / Google Maps link (Google Places API, New)
GOOGLE_PLACES_API_KEY=

# Website screenshots (Playwright + Chromium). auto | off
SCREENSHOTS=auto
CHROMIUM_PATH=

# Payments: Stripe hosted Checkout (subscription mode). Point the webhook at /api/webhooks/payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=           # recurring CA$59/month price
STRIPE_AUTOMATIC_TAX=true  # requires Stripe Tax to be set up for your account

# Notifications
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
RESEND_API_KEY=
EMAIL_FROM=                # e.g. "Blue Park <hello@yourdomain>"

# Hosting / custom domains (customers point DNS here)
HOSTING_BASE_DOMAIN=
HOSTING_CNAME_TARGET=
HOSTING_APEX_IP=

# Tests/dev only
DEMO_STAGE_DELAY_MS=2200
RATE_LIMIT_SCALE=1
